# Copy this file to .env and adjust paths for the target VM.

# Install locations on the VM (used by scripts/*.sh to find bin/ commands)
KAFKA_HOME=/path/to/kafka
SPARK_HOME=/path/to/spark

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_REQUEST_TOPIC=salary_requests
KAFKA_PREDICTION_TOPIC=salary_predictions
KAFKA_DATASET_TOPIC=developer_events
KAFKA_DEAD_LETTER_TOPIC=salary_dead_letter
KAFKA_ANALYTICS_TOPIC=salary_analytics

# Spark
# Use local[*] for a single-node VM, or spark://<host>:7077 if a standalone
# cluster (master + workers) is already running on the VM.
SPARK_MASTER_URL=local[*]
SPARK_APP_NAME=TechSalaryPrediction
# Only takes effect for a fresh JVM (spark-submit / plain python run / brand-new kernel) -
# heap size is fixed at JVM startup, so this can't resize an already-running session.
SPARK_DRIVER_MEMORY=4g

# Paths (relative to the repo root unless changed)
DATASET_PATH=./data/raw/survey_results_public.csv
MODEL_PATH=./models/best_salary_model
MODEL_METADATA_PATH=./models/model_metadata.json
MODEL_COMPARISON_PATH=./models/model_comparison.csv
MODEL_METRICS_PATH=./models/model_metrics.json

PREDICTION_CHECKPOINT_PATH=./checkpoints/salary_predictions
ANALYTICS_CHECKPOINT_PATH=./checkpoints/developer_events

# Reproducibility / feature engineering
RANDOM_SEED=42
TOP_LANGUAGES=20
TOP_DATABASES=15
TOP_PLATFORMS=15
TOP_EMPLOYMENT_STATUSES=10
# Rows with a target above this are dropped as implausible before log1p (see §10.9 /
# data_cleaning.py) - this dataset's max value is $74,351,432, almost certainly an error.
MAX_PLAUSIBLE_SALARY=1000000

# Producer / dashboard behavior
DATASET_EVENT_DELAY_SECONDS=2
DASHBOARD_PREDICTION_TIMEOUT_SECONDS=30
